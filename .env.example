# Application Settings
HOST=0.0.0.0
PORT=8007
MAX_FILE_SIZE=1048576
RELOAD=false

# Database Settings (use existing PostgreSQL server)
DATABASE_URL=postgresql://noodleuser:noodlepass@192.168.2.1:5433/noodleplanner

# Activity Logging
ENABLE_ACTIVITY_LOGGING=true

# Accounts and server-side plan storage (SQLite). In Docker this is set by
# docker-compose.yml to /data/noodleplanner.db (a bind mount of ./data).
# NOODLE_DB_PATH=data/noodleplanner.db
# Set to false once everyone who needs an account has one.
# ALLOW_REGISTRATION=true
# Password-reset links are emailed when SMTP_HOST and PUBLIC_BASE_URL are both
# set; otherwise the link is written to the server log.
# PUBLIC_BASE_URL=https://planner.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noodleplanner@example.com
