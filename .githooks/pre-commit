#!/bin/sh
# Pre-commit hook: synchronize bug docs and update index automatically.

echo "[pre-commit] Running bug sync script..."
python scripts/sync_bugs.py || {
  echo "[pre-commit] Bug sync failed; aborting commit." >&2
  exit 1
}

# Stage any changes produced by sync (index or moved files)
git add docs/bugs/index.md docs/bugs/open docs/bugs/fixed 2>/dev/null || true

echo "[pre-commit] Bug docs synchronized."
