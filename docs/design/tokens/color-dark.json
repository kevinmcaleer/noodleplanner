  "avatar-bg": {
    "$value": "{ink}",
    "$type": "color",
    "$description": "The same pairing, which in this theme means the light one on top: dark\nmode's --np-ink is #FAF8F4 and its --np-paper is #201E1A. A literally\nblack chip would be the note's own darkness again, and the ring the note\ndraws around it would be the only thing keeping it visible. Taking the\ntokens rather than the values is what makes it invert on its own."
  },
