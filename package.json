{
  "name": "noodleplanner",
  "private": true,
  "description": "Front-end tooling for NoodlePlanner. The app has no bundler: the libraries the browser loads (mppwriter, jspdf, docx, DejaVu Sans Mono, exceljs, jszip, pptxgenjs) are vendored into static/vendor/<lib> by the `npm run vendor:<lib>` scripts.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "vendor:mppwriter": "node scripts/vendor-mppwriter.mjs",
    "vendor:jspdf": "node scripts/vendor-jspdf.mjs",
    "vendor:docx": "node scripts/vendor-docx.mjs",
    "vendor:dejavu": "node scripts/vendor-dejavu.mjs",
    "vendor:exceljs": "node scripts/vendor-exceljs.mjs",
    "vendor:jszip": "node scripts/vendor-jszip.mjs",
    "vendor:pptxgenjs": "node scripts/vendor-pptxgenjs.mjs",
    "vendor": "npm run vendor:mppwriter && npm run vendor:jspdf && npm run vendor:docx && npm run vendor:dejavu && npm run vendor:exceljs && npm run vendor:jszip && npm run vendor:pptxgenjs",
    "audit:tokens": "node scripts/token-audit.mjs",
    "design:tokens": "node scripts/design-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint:design": "node scripts/lint-design-system.mjs",
    "design:consolidation": "node scripts/token-consolidation.mjs",
    "design:map": "node scripts/ui-structure-map.mjs",
    "design:explorer": "node scripts/design-system-explorer.mjs",
    "design:screens": "uv run python scripts/capture_screen_audit.py",
    "design:board": "uv run python scripts/annotate_audit_board.py penpot/screen-audit --standalone",
    "design": "npm run design:consolidation && npm run design:map && npm run design:explorer",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:js": "node --test tests/test_*.mjs && for f in tests/test_*.js; do node \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@projectwallace/css-analyzer": "^9.9.3",
    "@projectwallace/css-design-tokens": "^0.11.11",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/web-components": "10.6.0",
    "@storybook/web-components-vite": "10.6.0",
    "dejavu-fonts-ttf": "2.37.3",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "fake-indexeddb": "6.2.5",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "mppwriter": "0.4.0",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "storybook": "10.6.0",
    "storybook-addon-pseudo-states": "10.6.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": false
  }
}
