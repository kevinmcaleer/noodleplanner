# Copy to .env (git-ignored) and fill in. Read by ci/runner/docker-compose.yml.

# A GitHub PAT able to administer this repository's runners. Either:
#   - a fine-grained token scoped to kevinmcaleer/noodleplanner with
#     Administration: read and write  (preferred -- it can do nothing else), or
#   - a classic token with the `repo` scope.
# It is used only to mint short-lived registration tokens at container start.
RUNNER_TOKEN=

# The repository the runners attach to.
GITHUB_REPOSITORY=kevinmcaleer/noodleplanner

# Labels the workflows select on. `runs-on: [self-hosted, noodle]` in the
# workflow files matches these, so changing them means changing those too.
RUNNER_LABELS=self-hosted,linux,noodle

# Per-container limits. CI shares the host with production, so the default is
# deliberately modest; raise it if jobs start hitting their timeouts.
RUNNER_CPUS=2
RUNNER_MEMORY=4g
